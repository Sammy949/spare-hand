<Project Sdk="Microsoft.NET.Sdk">
  <!-- Versions track PowerToys main (net10 / WindowsAppSDK 2.2 / WinUIEx 2.8) so this can move upstream cleanly. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SpareHand</RootNamespace>
    <AssemblyName>SpareHand</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SpareHand.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- English UI only for now: skip the 3 MB of satellite resource assemblies. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Releases are trimmed, which disables reflection JSON; disable it everywhere so gaps show up in development. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!--
      PowerToys' settings for trimmed / AOT WinUI apps (src/Common.Dotnet.AotCompatibility.props). The CsWinRT AOT
      optimizer generates, at compile time, the interop glue WinUI needs to call into our own classes; without it a
      trimmed build failed with "XAML parsing failed" creating the first window.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6901" />
    <PackageReference Include="WinUIEx" Version="2.8.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />

    <!--
      Package diet. The Windows App SDK metapackage (pulled in directly and by the Community Toolkit) brings AI, ML,
      Widgets and WebView2 runtimes that Spare Hand never uses: onnxruntime + DirectML alone were ~38 MB. A direct
      reference with ExcludeAssets="all" keeps their files out of the build.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.2.3" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.70" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" ExcludeAssets="all" />
    <!-- ExcludeAssets does not cascade: the ML package's own dependency carries the 40 MB of ONNX Runtime + DirectML. -->
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.70" ExcludeAssets="all" />
    <PackageReference Include="System.Numerics.Tensors" Version="9.0.0" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Trimming roots: XAML creates these libraries' types by name at runtime, which the trimmer can't see, so a
      trimmed build failed in TrayWindow.InitializeComponent with "XAML parsing failed". They're small; the savings
      come from trimming the .NET runtime and the 25 MB Windows SDK projection, which stay trimmed.
    -->
    <!--
      Spare Hand itself: its [ComImport] shell interfaces are declared in vtable order, and the trimmer removes the
      methods we never call, which shifts the vtable (open Explorer folders came back empty). The assembly is small.
    -->
    <TrimmerRootAssembly Include="SpareHand" />
    <TrimmerRootAssembly Include="WinUIEx" />
    <TrimmerRootAssembly Include="Microsoft.WinUI" />
    <TrimmerRootAssembly Include="Microsoft.InteractiveExperiences.Projection" />
    <TrimmerRootAssembly Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <TrimmerRootAssembly Include="CommunityToolkit.WinUI.Triggers" />
    <TrimmerRootAssembly Include="CommunityToolkit.WinUI.Helpers" />
    <TrimmerRootAssembly Include="CommunityToolkit.WinUI.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <!-- The app icon, also loaded at runtime for the notification area and windows. -->
    <Content Include="Assets\SpareHand.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\SpareHand.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    The app's own resource index (SpareHand.pri, which also carries the compiled XAML) is generated into the build
    output but an unpackaged publish doesn't copy it. Without it every window fails with "XAML parsing failed".
  -->
  <Target Name="PublishProjectPri" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" RelativePath="$(ProjectPriFileName)" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(ProjectPriFullPath)')" />
    </ItemGroup>
  </Target>
</Project>
