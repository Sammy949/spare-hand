<UserControl
    x:Class="SpareHand.Tray.TrayTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!--
        One drop target. Values from the PowerToys language (docs/design.md): tile radius 6, 32px real icon or a
        24px Fluent glyph in the secondary colour, 12px label with ellipsis. The accent fill appears only on
        the tile the file is about to land on; nothing else on the tray uses the accent.
    -->
    <Grid
        x:Name="Surface"
        Padding="6,4"
        AllowDrop="True"
        Background="Transparent"
        CornerRadius="6"
        DragEnter="OnDragEnter"
        DragLeave="OnDragLeave"
        DragOver="OnDragOver"
        Drop="OnDrop"
        >
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DropStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Hot">
                    <VisualState.Setters>
                        <Setter Target="Surface.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="TitleText.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <Setter Target="SubtitleText.Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                        <Setter Target="GlyphIcon.Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Dimmed">
                    <VisualState.Setters>
                        <Setter Target="Surface.Opacity" Value="0.38" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  Icon and label sit together, centred, whatever the tile height (Hold is tall).  -->
        <StackPanel
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Spacing="6">
            <Grid
                Width="32"
                Height="32"
                HorizontalAlignment="Center">
                <Image
                    x:Name="IconImage"
                    Width="32"
                    Height="32"
                    Stretch="Uniform" />
                <FontIcon
                    x:Name="GlyphIcon"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="24"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <TextBlock
                x:Name="TitleText"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                LineHeight="15"
                MaxLines="2"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="WrapWholeWords" />

            <TextBlock
                x:Name="SubtitleText"
                Margin="0,-4,0,0"
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
