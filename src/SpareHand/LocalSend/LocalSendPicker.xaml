<winex:WindowEx
    x:Class="SpareHand.LocalSend.LocalSendPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx"
    Title="Send with LocalSend">
    <!--  Opens where the file was dropped. Margin 24 = shadow room, as on the tray.  -->
    <Grid
        x:Name="Root"
        Background="Transparent"
        KeyDown="OnRootKeyDown">
        <ContentControl
            x:Name="Card"
            Width="320"
            Margin="24"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource SpareHandCard}">
            <StackPanel Padding="12,12,12,10" Spacing="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                        <Image x:Name="AppIcon" Width="24" Height="24" />
                        <FontIcon
                            x:Name="AppGlyph"
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE72D;" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="Send with LocalSend" />
                        <TextBlock
                            x:Name="WhatText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <ListView
                    x:Name="Devices"
                    MaxHeight="280"
                    Margin="-4,0"
                    IsItemClickEnabled="True"
                    ItemClick="OnDeviceClick"
                    SelectionMode="None" />

                <Grid x:Name="StatusRow" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  Stop searching, or stop a send that's waiting or uploading. Esc does the same.  -->
                    <Button
                        x:Name="CancelButton"
                        Grid.Column="2"
                        Padding="10,3"
                        VerticalAlignment="Center"
                        Click="OnCancelClick"
                        Content="Cancel"
                        FontSize="12" />
                    <ProgressRing
                        x:Name="Busy"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        IsActive="True" />
                    <FontIcon
                        x:Name="StatusGlyph"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="StatusText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </ContentControl>
    </Grid>
</winex:WindowEx>
