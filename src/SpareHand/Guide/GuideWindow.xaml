<winex:WindowEx
    x:Class="SpareHand.Guide.GuideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx"
    Title="Welcome to Spare Hand">
    <!--
        First-run guide: practice the gesture for real instead of reading about it. The window watches the same
        events the app runs on (a drag started, the tray opened, a drop on Hold, the library opened) and moves on
        when you've done each thing. PowerToys language: Mica, title bar with the icon, a content-dialog footer.
    -->
    <Grid x:Name="Root">
        <Grid.Resources>
            <!--
                The keycap teaches the rhythm: two quick presses, a rest, again. Animates a key that is always
                visible; it never gates content. Not started when Windows animations are off.
            -->
            <Storyboard x:Name="TapRhythm" RepeatBehavior="Forever">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KeyPress" Storyboard.TargetProperty="ScaleY">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="0.9" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.17" Value="1" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.27" Value="0.9" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.37" Value="1" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KeyPress" Storyboard.TargetProperty="TranslateY">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="2" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.17" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.27" Value="2" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.37" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Padding="16,0,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="18"
                Height="18"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/SpareHand.png" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Welcome to Spare Hand" />
        </Grid>

        <StackPanel Grid.Row="1" Padding="40,12,40,24">
            <TextBlock x:Name="StepTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="StepBody"
                Margin="0,8,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />

            <!--  The practice surface. Fixed height so the window never jumps between steps.  -->
            <Grid
                Height="248"
                Margin="0,24,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">

                <!--  Step 1: a real file to drag. Looks like a file on the desktop, not a button.  -->
                <Grid x:Name="PracticePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        x:Name="PracticeFile"
                        Width="120"
                        Padding="8,10,8,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Practice file, drag me"
                        Background="Transparent"
                        CanDrag="True"
                        CornerRadius="6"
                        DragStarting="OnPracticeDragStarting"
                        PointerEntered="OnPracticePointerEntered"
                        PointerExited="OnPracticePointerExited">
                        <StackPanel Spacing="6">
                            <Image
                                x:Name="PracticeIcon"
                                Width="48"
                                Height="48" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Practice file.txt" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  Step 3: what else the tray does. Bare glyphs, no tiles.  -->
                <StackPanel
                    x:Name="SummaryPanel"
                    Padding="24,20"
                    Spacing="14"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE72D;" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Send." />
                            <Run Text="Quick Share or LocalSend. You pick the device after you drop." />
                        </TextBlock>
                    </Grid>
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8DE;" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Move to." />
                            <Run Text="Desktop, or More… for any folder. Same rules as File Explorer, with undo." />
                        </TextBlock>
                    </Grid>
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE713;" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Settings." />
                            <Run x:Name="SettingsLine" Text="Right-click the hand in the notification area. Alt can become Ctrl or Shift there." />
                        </TextBlock>
                    </Grid>
                    <!--  Two switches side by side, so the step stays inside the fixed-height surface.  -->
                    <Grid Margin="34,2,0,0" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch
                            x:Name="StartWithWindows"
                            Header="Start when I sign in"
                            Toggled="OnStartWithWindowsToggled" />
                        <ToggleSwitch
                            x:Name="HoldNewScreenshots"
                            Grid.Column="1"
                            Header="Hold new screenshots"
                            Toggled="OnHoldNewScreenshotsToggled" />
                    </Grid>
                </StackPanel>

                <!--  Live status for steps 1 and 2: the key to press, and what Spare Hand is waiting for.  -->
                <StackPanel
                    x:Name="StatusRow"
                    Margin="0,0,0,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="12">
                    <!--  PowerToys KeyVisual: an accent keycap, pressed from the bottom edge.  -->
                    <Border
                        x:Name="Keycap"
                        MinWidth="52"
                        Height="36"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="KeyPress" />
                        </Border.RenderTransform>
                        <TextBlock
                            x:Name="KeycapText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Text="Alt" />
                    </Border>
                    <FontIcon
                        x:Name="DoneMark"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;"
                        RenderTransformOrigin="0.5,0.5"
                        Visibility="Collapsed">
                        <FontIcon.RenderTransform>
                            <ScaleTransform x:Name="DonePop" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                    <TextBlock
                        x:Name="StatusText"
                        MaxWidth="360"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!--  Content-dialog footer: its own surface, one primary action on the right.  -->
        <Grid
            Grid.Row="2"
            Padding="24,18"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <HyperlinkButton
                x:Name="SkipGuide"
                Click="OnSkipGuide"
                Content="Skip the guide" />
            <TextBlock
                x:Name="Progress"
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <Button
                x:Name="NextButton"
                Grid.Column="3"
                MinWidth="120"
                Click="OnNext" />
        </Grid>
    </Grid>
</winex:WindowEx>
